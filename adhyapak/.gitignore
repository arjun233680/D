node_modules/
.next/
dist/
# Next.js static export output. Wildcarded because the web app is paused under
# apps/_web-paused, and a fixed path stops matching the moment a folder is
# renamed — which is how 15M of stale build output came to sit in git status.
apps/*/out/
.expo/
# Generated by `expo prebuild` from app.json. Committing them would mean two
# sources of truth for the same native project, and the one in git would be the
# stale one.
apps/mobile/android/
apps/mobile/ios/
web-build/
*.tsbuildinfo
.DS_Store
.env*.local
# Expo reads apps/mobile/.env, which .env*.local does not match — the key in it
# is the public anon key, but a credentials file still has no business in git.
.env
apps/*/.env
.screens/
