# Copy to apps/web/.env.local and apps/mobile/.env, then fill in from your
# Supabase project: Settings -> API. Both keys below are the public anon key —
# it is safe in a client because row-level security is what protects the data.

# Web (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Mobile (Expo)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Never put the service_role key in either app. It bypasses row-level security
# and belongs only in server-side scripts you run yourself.
